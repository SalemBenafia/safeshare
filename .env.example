# Copy this file to .env.local and fill in the values from:
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration > Config
# .env.local is ignored by git. Never commit real values or App Check debug tokens.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google Cloud console > Security > reCAPTCHA > your website key
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional, local development only: App Check debug token for localhost.
# Register it in Firebase console > App Check > Apps > Manage debug tokens. Never commit a real value.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Public URL of the deployed site (used for Open Graph links). Defaults to the Firebase Hosting URL.
NEXT_PUBLIC_SITE_URL=
